<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="NexSync.Android.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:NexSync.Android.Pages"
    Title="NexSync">

    <TabBar>
        <Tab Title="Files" Icon="dotnet_bot.png">
            <ShellContent
                Title="Files"
                ContentTemplate="{DataTemplate pages:BrowserPage}"
                Route="browser" />
        </Tab>
    </TabBar>

</Shell>

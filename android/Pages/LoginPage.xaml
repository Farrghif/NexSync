<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NexSync.Android.Pages.LoginPage"
             Title="Sign In"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F6F7FB, Dark=#0B0C12}">

    <ScrollView>
        <VerticalStackLayout Padding="24,28" Spacing="0" HorizontalOptions="Center" MaximumWidthRequest="480" VerticalOptions="Center">

            <!-- Brand badge -->
            <HorizontalStackLayout Spacing="12" HorizontalOptions="Center" Margin="0,0,0,8">
                <Frame BackgroundColor="#5B5BD6" CornerRadius="12" WidthRequest="44" HeightRequest="44" Padding="0" HasShadow="False" BorderColor="Transparent" VerticalOptions="Center">
                    <Label Text="☁" TextColor="White" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center"/>
                </Frame>
                <Label Text="NexSync" FontSize="26" FontAttributes="Bold" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#14161D, Dark=#F2F3F8}"/>
            </HorizontalStackLayout>

            <Label Text="Private sync between browser and Windows. No manual copying."
                   FontSize="12" TextColor="#8B90A0" HorizontalTextAlignment="Center"
                   Margin="0,0,0,14" Padding="12,0"/>

            <!-- Honest claims -->
            <VerticalStackLayout Spacing="6" Margin="0,0,0,18" HorizontalOptions="Center">
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="✓" FontSize="11" FontAttributes="Bold" TextColor="#1DB954" VerticalOptions="Center"/>
                    <Label Text="Automatic two-way sync" FontSize="11" TextColor="#8B90A0" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="✓" FontSize="11" FontAttributes="Bold" TextColor="#1DB954" VerticalOptions="Center"/>
                    <Label Text="Crash-safe on Windows desktop" FontSize="11" TextColor="#8B90A0" VerticalOptions="Center"/>
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                    <Label Text="✓" FontSize="11" FontAttributes="Bold" TextColor="#1DB954" VerticalOptions="Center"/>
                    <Label Text="Revoke any device" FontSize="11" TextColor="#8B90A0" VerticalOptions="Center"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <Label Text="Welcome back" FontSize="20" FontAttributes="Bold" HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light=#14161D, Dark=#F2F3F8}"/>
            <Label Text="Sign in to continue" FontSize="12" TextColor="#8B90A0" HorizontalTextAlignment="Center" Margin="0,4,0,16"/>

            <!-- Card -->
            <Frame BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#14161F}"
                   BorderColor="{AppThemeBinding Light=#E6E8EF, Dark=#262A38}"
                   CornerRadius="16" Padding="20" HasShadow="False">
                <VerticalStackLayout Spacing="14">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="SERVER URL" FontSize="11" FontAttributes="Bold" TextColor="#8B90A0"/>
                        <Border Stroke="{AppThemeBinding Light=#E6E8EF, Dark=#262A38}" StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F111A}" Padding="10,1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Entry x:Name="ServerUrlEntry" Placeholder="http://10.0.2.2:5189/api"
                                   Keyboard="Url" ReturnType="Next" FontSize="14"
                                   TextColor="{AppThemeBinding Light=#14161D, Dark=#F2F3F8}" PlaceholderColor="#8B90A0"
                                   BackgroundColor="Transparent"/>
                        </Border>
                        <Label Text="10.0.2.2 for emulator, your LAN IP for device" FontSize="10" TextColor="#8B90A0"/>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="EMAIL" FontSize="11" FontAttributes="Bold" TextColor="#8B90A0"/>
                        <Border Stroke="{AppThemeBinding Light=#E6E8EF, Dark=#262A38}" StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F111A}" Padding="10,1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Entry x:Name="EmailEntry" Placeholder="you@example.com"
                                   Keyboard="Email" ReturnType="Next" FontSize="14"
                                   TextColor="{AppThemeBinding Light=#14161D, Dark=#F2F3F8}" PlaceholderColor="#8B90A0"
                                   BackgroundColor="Transparent" Completed="OnEmailCompleted"/>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="PASSWORD" FontSize="11" FontAttributes="Bold" TextColor="#8B90A0"/>
                        <Border Stroke="{AppThemeBinding Light=#E6E8EF, Dark=#262A38}" StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F111A}" Padding="10,1">
                            <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="0">
                                <Entry x:Name="PasswordEntry" Placeholder="••••••••" IsPassword="True" ReturnType="Done"
                                       FontSize="14" TextColor="{AppThemeBinding Light=#14161D, Dark=#F2F3F8}" PlaceholderColor="#8B90A0"
                                       BackgroundColor="Transparent" Completed="OnSignInClicked"/>
                                <Button Grid.Column="1" x:Name="TogglePasswordBtn" Text="Show" FontSize="11" FontAttributes="Bold"
                                        TextColor="#5B5BD6" BackgroundColor="Transparent" Padding="8,0"
                                        Clicked="OnTogglePasswordClicked"/>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error -->
                    <Border x:Name="ErrorFrame" IsVisible="False" StrokeThickness="0" BackgroundColor="#FDECEE" Padding="10">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                        <Label x:Name="ErrorLabel" TextColor="#C62B3C" FontSize="12" IsVisible="False"/>
                    </Border>

                    <!-- Sign In button with spinner overlay -->
                    <Grid Margin="0,6,0,0">
                        <Button x:Name="SignInBtn" Text="Sign In" BackgroundColor="#5B5BD6" TextColor="White"
                                CornerRadius="12" HeightRequest="48" FontAttributes="Bold" FontSize="14"
                                Clicked="OnSignInClicked"/>
                        <ActivityIndicator x:Name="BusyIndicator" IsRunning="False" IsVisible="False"
                                           Color="White" HeightRequest="22" WidthRequest="22"
                                           HorizontalOptions="Center" VerticalOptions="Center" InputTransparent="True"/>
                    </Grid>

                    <Button Text="Don't have an account?  Register →" TextColor="#5B5BD6" FontSize="13"
                            BackgroundColor="Transparent" Clicked="OnGoToRegisterClicked" Padding="0" Margin="0,4,0,0"/>
                </VerticalStackLayout>
            </Frame>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>

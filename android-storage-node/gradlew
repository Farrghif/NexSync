##############################################################################
#
#   Gradle start up script for POSIX generated by Gradle.
#
#   Important for running:
#
#   (1) You need a POSIX-compliant shell to run this script. If your /bin/sh is
#       noncompliant, but you have some other compliant shell such as bash or ksh,
#       you may want to run Gradle using that shell instead.
#
#   (2) Gradle will search for itself in your PATH.
#
##############################################################################

if [ -z "$GRADLE_HOME" ] ; then
  GRADLE_HOME=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" && pwd )
fi

GRADLE_APP_NAME="Gradle" 
APP_HOME=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" && pwd )

APP_PATH_EXPORT="$APP_HOME"

case "$(uname)" in
  *CYGWIN*) APP_HOME=`(cd "$APP_HOME"; pwd -W)`
            APP_PATH_EXPORT="$APP_HOME"
            PATH_SEPARATOR=";"
            ;;
  *MINGW*) APP_HOME="`(cd "$APP_HOME"; pwd -W)`"
            APP_PATH_EXPORT="$APP_HOME"
            PATH_SEPARATOR=";"
            ;;
  *MSYS*) APP_HOME="`(cd "$APP_HOME"; pwd -W)`"
            APP_PATH_EXPORT="$APP_HOME"
            PATH_SEPARATOR=";"
            ;;
  *)
            APP_PATH_EXPORT="$APP_HOME"
            PATH_SEPARATOR=":"
            ;;
esac

# Increase the maximum file descriptors if we can.
if [ -n "$MAX_FD" ] ; then
    MAX_FD_LIMIT=$(ulimit -H -n)
    if [ $? -eq 0 ] ; then
        if [ "$MAX_FD" = "maximum" -o "$MAX_FD" = "max" ] ; then
          MAX_FD="$MAX_FD_LIMIT"
        fi
        ulimit -n $MAX_FD
        if [ $? -ne 0 ] ; then
            warn "Could not set maximum file descriptor limit to $MAX_FD"
        fi
    else
        warn "Could not query maximum file descriptor limit"
    fi
fi

# For Darwin, add options to specify how the application appears in the dock
if $darwin; then
    GRADLE_OPTS="$GRADLE_OPTS \"-Xdock:name=$GRADLE_APP_NAME\" \"-Xdock:icon=$APP_HOME/media/gradle.icns\""
fi

# For Cygwin or MSYS, switch paths to Windows format before running java
if [ "$cygwin" = "true" -o "$msys" = "true" ] ; then
    APP_HOME=`cygpath --path --mixed "$APP_HOME"`
    CLASSPATH=`cygpath --path --mixed "$CLASSPATH"`
    JAVACMD=`cygpath --unix "$JAVACMD"`

    # We build the pattern for arguments to be converted via cygpath
    ROOTDIRSRAW=`find -L / -maxdepth 3 -type d -name src 2>/dev/null | head -20`
    SEP=""
    for dir in $ROOTDIRSRAW ; do
        ROOTDIRS="$ROOTDIRS$SEP$dir"
        SEP="|"
    done
    OURCYGPATTERN="(^($ROOTDIRS))"
    APP_HOME=`cygpath --path --mixed "$APP_HOME"`
    APP_HOME_MIXED=`cygpath --path --mixed "$APP_HOME"`
    CLASSPATH=`cygpath --path --mixed "$CLASSPATH"`
    CLASSPATH_MIXED=`cygpath --path --mixed "$CLASSPATH"`

    JAVACMD=`cygpath --unix "$JAVACMD"`

    # Now convert the arguments - kludge to limit ourselves to /bin/sh
    i=0
    for arg in "$@" ; do
        CHECK=`echo "$arg"|egrep -c "$OURCYGPATTERN" -`
        CHECK2=`echo "$arg"|egrep -c "^-"` ### Determine if an option

        if [ $CHECK -ne 0 ] && [ $CHECK2 -eq 0 ] ; then ### Added a path
            arg=`cygpath --path --unix "$arg"`
        fi
        BUILD_PATH="$BUILD_PATH$arg"
        i=$(($i+1))
        if [ $i -eq $ARGS_COUNT ] ; then
            SEP=""
        else
            SEP=" "
        fi
    done
    $JAVACMD $GRADLE_OPTS \
        -classpath "$CLASSPATH" \
        org.gradle.wrapper.GradleWrapperMain \
        "$BUILD_PATH"

else
    $JAVACMD $GRADLE_OPTS \
        -classpath "$CLASSPATH" \
        org.gradle.wrapper.GradleWrapperMain \
        "$@"
fi

exit $?

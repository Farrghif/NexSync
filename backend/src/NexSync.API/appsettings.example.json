{
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_DB_HOST;Database=nexsync;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;Port=5432"
  },
  "Jwt": {
    "Secret": "GENERATE_A_SECURE_32_CHARACTER_SECRET_KEY_HERE",
    "Issuer": "NexSync",
    "Audience": "NexSync",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Storage": {
    "RootPath": "./storage",
    "MaxFileSizeBytes": 104857600
  },
  "Cors": {
    "Origins": [
      "http://localhost:5173",
      "https://yourdomain.com"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "NexSync": "Information"
    }
  },
  "AllowedHosts": "*"
}
